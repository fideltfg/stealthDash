# Production Dockerfile
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (needed for build)
RUN npm ci

# Copy source
COPY src ./src
COPY http ./http
COPY scripts ./scripts
COPY tsconfig*.json vite.config.ts ./

# Build application
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built files to nginx
COPY --from=builder /app/http/dist /usr/share/nginx/html
COPY --from=builder /app/http/widget-metadata.json /usr/share/nginx/html/widget-metadata.json

# Copy nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
